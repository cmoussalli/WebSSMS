{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The AI assistant panel. See README "AI assistant". Anything here is only the
  // default: the panel's settings dialog overrides it and saves the result to
  // SettingsFile below, which is what survives a restart.
  "Ai": {
    // False removes the panel from the UI entirely. Not overridable from the dialog.
    "Enabled": true,

    // Where Save writes. Empty = App_Data/ai-settings.json next to the app. A folder
    // is fine too. It holds the API key in plain text, so keep it off a share.
    "SettingsFile": "",

    // Ollama | DeepSeek | OpenAI | Custom -- all spoken to as OpenAI-compatible.
    "Provider": "Ollama",

    // Empty = the provider's own default (Ollama http://localhost:11434/v1,
    // DeepSeek https://api.deepseek.com/v1, OpenAI https://api.openai.com/v1).
    "BaseUrl": "",

    // Empty = the provider default. A model that can call tools is strongly preferred.
    "Model": "",

    // Usually left empty -- enter the key in the settings dialog instead, which
    // saves it to SettingsFile rather than into source control.
    "ApiKey": "",

    // Low keeps generated SQL predictable. Negative = leave it to the server.
    "Temperature": 0.1,

    // 0 = omit the field, which a few models require.
    "MaxTokens": 4096,

    "TimeoutSeconds": 120,

    // Off for local models that cannot call functions -- they get a one-shot
    // schema digest of the current database instead of live lookups.
    "UseTools": true,

    // Ceiling on schema/data lookups per question.
    "MaxToolCalls": 12,

    // Lets the assistant read rows, not just structure. Read-only either way.
    "AllowDataQueries": true,

    // Rows returned from one look at the data.
    "MaxRows": 20
  },

  // Controls downloading and uploading of .bak files. See README "Backup file transfer".
  "BackupStorage": {
    // Folders the transfer endpoints may touch. Empty = any folder, as long as the
    // extension below matches. Set this on any shared deployment.
    "AllowedDirectories": [],
    // Authoritative when set; empty falls back to .bak/.trn/.dif/.bkp.
    "AllowedExtensions": [ ".bak", ".trn", ".dif", ".bkp" ],

    // Pull a backup through the SQL connection when the web app cannot see the
    // path itself. Requires ADMINISTER BULK OPERATIONS; capped at 2 GB per file.
    "AllowSqlServerTransfer": true,

    "AllowUpload": true,

    // 0 = unlimited.
    "MaxUploadBytes": 0,

    "TicketLifetimeMinutes": 30,

    // Pre-filled in the UI. Empty = ask SQL Server for its default backup path.
    "DefaultDirectory": ""
  }
}
